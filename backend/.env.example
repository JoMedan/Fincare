# ──────────────────────────────────────────────────────────────
# .env.example — 실제 값은 .env 파일에 복사하여 설정하세요.
# .env 파일은 절대 Git에 커밋하지 마세요!
# ──────────────────────────────────────────────────────────────

# DB 비밀번호
DB_PASSWORD=csedbadmin

# JWT 서명 키 (운영 환경에서는 반드시 강력한 랜덤 문자열로 변경)
JWT_SECRET=your-256-bit-secret-key-that-is-very-secure-and-long-enough

# CORS 허용 출처 (프론트엔드 주소)
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# OpenAI API Key
OPENAI_API_KEY=sk-...
